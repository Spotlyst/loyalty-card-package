{
  "name": "@spotlyst/loyalty-card",
  "version": "0.3.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spotlyst/loyalty-card-package.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": ["dist/react/index.d.ts"],
      "schema": ["dist/schema.d.ts"],
      "normalize": ["dist/normalize.d.ts"],
      "fixtures": ["dist/fixtures.d.ts"],
      "fonts": ["dist/fonts.d.ts"],
      "editor": ["dist/editor/index.d.ts"],
      "*": ["dist/index.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "import": "./dist/normalize.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./editor.css": "./dist/editor/editor.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepublishOnly": "tsc -p tsconfig.json && node scripts/copy-assets.mjs"
  },
  "peerDependencies": {
    "@hugeicons/core-free-icons": ">=4",
    "@hugeicons/react": ">=1",
    "lucide-react": ">=0.4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@hugeicons/core-free-icons": { "optional": true },
    "@hugeicons/react": { "optional": true },
    "lucide-react": { "optional": true }
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^0.562.0",
    "typescript": "~6.0.2"
  }
}
